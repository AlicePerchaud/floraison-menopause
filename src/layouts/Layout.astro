---
interface Props {
  title: string;
  description?: string;
  ogType?: string;
  schema?: object | object[];
}

const SITE_URL = "https://superb-mermaid-6a5c2a.netlify.app";
const SITE_NAME = "Floraison";

const {
  title,
  description = "Guide complet sur la ménopause : symptômes, traitements, conseils et ressources pour traverser cette période avec sérénité.",
  ogType = "website",
  schema,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, SITE_URL).href;
const fullTitle = `${title} — ${SITE_NAME}`;

const nav = [
  { href: "/", label: "Accueil" },
  { href: "/articles", label: "Articles" },
  { href: "/faq", label: "FAQ" },
  { href: "/ressources", label: "Ressources" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <div class="container header-inner">
        <a href="/" class="logo">
          <span class="logo-icon">✿</span>
          <span>Floraison</span>
        </a>
        <nav>
          <ul>
            {nav.map(({ href, label }) => (
              <li>
                <a href={href} class={currentPath === href ? "active" : ""}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/contact" class="btn-nav">Prendre soin de soi</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="logo-icon">✿</span>
          <span class="footer-name">Floraison</span>
          <p>Un espace bienveillant pour traverser la ménopause avec sérénité et confiance.</p>
        </div>
        <div class="footer-links">
          <h4>Navigation</h4>
          <ul>
            {nav.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Contact</h4>
          <p>Des questions ? Nous sommes là pour vous.</p>
          <a href="/contact" class="btn-footer">Nous écrire</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Floraison — Informations à titre éducatif, pas de substitut médical.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --rose:       #c4748a;
    --rose-light: #e8d0d7;
    --rose-pale:  #fdf0f3;
    --mauve:      #8b5e83;
    --mauve-dark: #5c3a57;
    --cream:      #fdf8f5;
    --text:       #3d2b35;
    --text-light: #7a5f6e;
    --white:      #ffffff;
    --radius:     12px;
    --shadow:     0 4px 24px rgba(140, 94, 131, 0.10);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Lato', sans-serif;
    background: var(--cream);
    color: var(--text);
    line-height: 1.7;
    font-size: 16px;
  }

  h1, h2, h3, h4 {
    font-family: 'Playfair Display', serif;
    line-height: 1.3;
    color: var(--mauve-dark);
  }

  a { color: inherit; text-decoration: none; }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  header {
    background: var(--white);
    border-bottom: 1px solid var(--rose-light);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(196, 116, 138, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--mauve-dark);
  }

  .logo-icon { color: var(--rose); font-size: 1.6rem; }

  nav ul {
    display: flex;
    list-style: none;
    gap: 4px;
  }

  nav a {
    padding: 8px 14px;
    border-radius: 8px;
    color: var(--text-light);
    font-weight: 400;
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  nav a:hover, nav a.active {
    color: var(--rose);
    background: var(--rose-pale);
  }

  .btn-nav {
    background: var(--rose);
    color: var(--white) !important;
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 700;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .btn-nav:hover { background: var(--mauve); }

  /* Footer */
  footer {
    background: var(--mauve-dark);
    color: rgba(255,255,255,0.85);
    margin-top: 80px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    padding: 60px 24px 48px;
  }

  .footer-brand .logo-icon { color: var(--rose-light); }
  .footer-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--white);
    margin-left: 8px;
  }

  .footer-brand p {
    margin-top: 16px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.65);
  }

  .footer-links h4, .footer-contact h4 {
    color: var(--rose-light);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .footer-links ul { list-style: none; }
  .footer-links li { margin-bottom: 8px; }
  .footer-links a {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--rose-light); }

  .footer-contact p {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.65);
    margin-bottom: 16px;
  }

  .btn-footer {
    display: inline-block;
    background: var(--rose);
    color: var(--white);
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    transition: background 0.2s;
  }

  .btn-footer:hover { background: var(--rose-light); color: var(--mauve-dark); }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 20px 24px;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
  }

  /* Utility classes */
  .section { padding: 72px 0; }
  .section-alt { background: var(--white); padding: 72px 0; }

  .section-header { text-align: center; margin-bottom: 56px; }
  .section-header h2 { font-size: 2.2rem; margin-bottom: 16px; }
  .section-header p { color: var(--text-light); max-width: 560px; margin: 0 auto; font-size: 1.05rem; }

  .tag {
    display: inline-block;
    background: var(--rose-pale);
    color: var(--rose);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 12px;
  }

  .btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--rose);
    color: var(--white);
  }
  .btn-primary:hover { background: var(--mauve); transform: translateY(-1px); }

  .btn-outline {
    background: transparent;
    color: var(--rose);
    border: 2px solid var(--rose);
  }
  .btn-outline:hover { background: var(--rose); color: var(--white); }

  .card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 32px;
    box-shadow: var(--shadow);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px rgba(140, 94, 131, 0.15); }

  @media (max-width: 768px) {
    nav, .btn-nav { display: none; }
    .footer-inner { grid-template-columns: 1fr; gap: 32px; }
    .section-header h2 { font-size: 1.7rem; }
  }
</style>
